rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && userDoc().role == 'teacher';
    }

    function isParent() {
      return isSignedIn() && userDoc().role == 'parent';
    }

    function teacherHasGroup(groupId) {
      return isTeacher() && groupId in userDoc().assignedGroupIds;
    }

    function parentHasChild(studentId) {
      return isParent() && studentId in userDoc().linkedChildIds;
    }

    function parentHasGroup(groupId) {
      return isParent() && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.studentIds.hasAny(userDoc().linkedChildIds);
    }

    match /users/{userId} {
      // Active directory profiles expose only the fields the UI needs:
      // name, email, role, and status. Sensitive access fields remain protected
      // by the write rules below and are never trusted by the client.
      allow read: if isSignedIn() && (
        userId == request.auth.uid ||
        isAdmin() ||
        resource.data.status == 'active'
      );

      // Self-signup may only ever create a pending PARENT account.
      // Teacher/admin accounts must be created or promoted by an existing admin
      // (via the console for the first admin, or an admin-only flow after that).
      allow create: if isAdmin()
        || (isSignedIn() && userId == request.auth.uid
            && request.resource.data.role == 'parent'
            && request.resource.data.status == 'pending');

      // A user may edit their own profile (e.g. name/language), but can NEVER
      // change their own role/status/linkedChildIds/assignedGroupIds — those
      // are the fields that grant access, and only an admin may touch them.
      allow update: if isAdmin()
        || (isSignedIn() && userId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role', 'status', 'linkedChildIds', 'assignedGroupIds']));

      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.groupMemberships.size() > 0 &&
          resource.data.groupMemberships.exists(gm, teacherHasGroup(gm.groupId))) ||
        parentHasChild(studentId)
      );
      allow create, update, delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && (isAdmin() || teacherHasGroup(groupId));
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId) ||
        parentHasGroup(resource.data.groupId)
      );
      allow create, update, delete: if isAdmin() ||
        (teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId) ||
        parentHasGroup(resource.data.groupId)
      );
      allow create, update, delete: if isAdmin() ||
        (teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
    }

    match /progress/{progressId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId)
      );
      allow create, update, delete: if isAdmin() ||
        (teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.audience == 'all' ||
        resource.data.audience == request.auth.uid ||
        resource.data.audience == userDoc().role
      );
      allow create, update, delete: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
