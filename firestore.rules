rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && hasUserDoc() && userDoc().role == 'admin' && userDoc().status == 'active';
    }

    function isTeacher() {
      return isSignedIn() && hasUserDoc() && userDoc().role == 'teacher' && userDoc().status == 'active';
    }

    function isParent() {
      return isSignedIn() && hasUserDoc() && userDoc().role == 'parent' && userDoc().status == 'active';
    }

    function teacherHasGroup(groupId) {
      return isTeacher() && groupId in userDoc().assignedGroupIds;
    }

    function teacherHasAnyGroup(studentGroupIds) {
      return isTeacher()
        && studentGroupIds is list
        && userDoc().assignedGroupIds is list
        && studentGroupIds.hasAny(userDoc().assignedGroupIds);
    }

    function parentHasChild(studentId) {
      return isParent() && studentId in userDoc().linkedChildIds;
    }

    function parentHasGroup(groupId) {
      return isParent() && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.studentIds.hasAny(userDoc().linkedChildIds);
    }

    match /users/{userId} {
      // A profile is readable only by its owner or an admin. Do NOT widen
      // this to "any active user" — a full-document read leaks
      // linkedChildIds/assignedGroupIds to anyone signed in. The public
      // messaging directory below (directory/{userId}) is the
      // deliberately-minimal collection this comment used to ask for.
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());

      // Self-signup may create a pending PARENT or TEACHER account only.
      // Admin accounts must be created or promoted by an existing admin (the
      // very first admin is bootstrapped manually in Firebase Console, per
      // the README). isAdmin()/isTeacher() do not grant anything until
      // `status` is flipped to 'active' by an admin, so allowing 'teacher'
      // here does not grant teacher privileges at signup time — do not
      // add 'admin' to this list.
      allow create: if isAdmin()
        || (isSignedIn() && userId == request.auth.uid
            && request.resource.data.role in ['parent', 'teacher']
            && request.resource.data.status == 'pending');

      // A user may edit their own profile (e.g. name/language), but can
      // NEVER change their own role/status/linkedChildIds/assignedGroupIds —
      // those are the fields that grant access, and only an admin may touch
      // them.
      allow update: if isAdmin()
        || (isSignedIn() && userId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role', 'status', 'linkedChildIds', 'assignedGroupIds', 'consentGiven', 'consentDate']));

      allow delete: if isAdmin();
    }

    // Minimal, non-sensitive profile (name + role only) so any signed-in
    // user can build a messaging recipient list, without exposing the
    // protected fields on users/{uid} (linkedChildIds, assignedGroupIds,
    // email, status). Only admins write it, at approval time (and for the
    // first, manually-bootstrapped admin — see README).
    match /directory/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasAnyGroup(resource.data.groupIds) ||
        parentHasChild(studentId)
      );
      allow create, update, delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && (isAdmin() || teacherHasGroup(groupId));
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId)
      );
      allow create: if isAdmin() ||
        (teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
      allow update: if isAdmin() ||
        (teacherHasGroup(resource.data.groupId) && 
         teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin() ||
        (teacherHasGroup(resource.data.groupId) &&
         resource.data.teacherId == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId) ||
        parentHasGroup(resource.data.groupId)
      );
      allow create: if isAdmin() ||
        (teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
      allow update: if isAdmin() ||
        (teacherHasGroup(resource.data.groupId) && 
         teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin() ||
        (teacherHasGroup(resource.data.groupId) &&
         resource.data.teacherId == request.auth.uid);
    }

    match /progress/{progressId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId)
      );
      allow create: if isAdmin() ||
        (teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
      allow update: if isAdmin() ||
        (teacherHasGroup(resource.data.groupId) && 
         teacherHasGroup(request.resource.data.groupId) &&
         request.resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin() ||
        (teacherHasGroup(resource.data.groupId) &&
         resource.data.teacherId == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && (isAdmin() || isTeacher() || isParent())
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread', 'unreadFor']);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.audience == 'all' ||
        resource.data.audience == request.auth.uid ||
        resource.data.audience == userDoc().role
      );
      allow create, update, delete: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
