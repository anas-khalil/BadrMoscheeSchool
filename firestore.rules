rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isParent() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    function teacherHasGroup(groupId) {
      return isTeacher() && groupId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedGroupIds;
    }

    function parentHasChild(studentId) {
      return isParent() && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedChildIds;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if isAdmin() || (userId == request.auth.uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupMemberships[0].groupId) ||
        parentHasChild(studentId)
      );
      allow create, update, delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && (isAdmin() || teacherHasGroup(groupId));
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId)
      );
      allow create, update, delete: if isAdmin() || teacherHasGroup(request.resource.data.groupId);
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId)
      );
      allow create, update, delete: if isAdmin() || teacherHasGroup(request.resource.data.groupId);
    }

    match /progress/{progressId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        teacherHasGroup(resource.data.groupId) ||
        parentHasChild(resource.data.studentId)
      );
      allow create, update, delete: if isAdmin() || teacherHasGroup(request.resource.data.groupId);
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.audience == 'all' ||
        resource.data.audience == request.auth.uid ||
        resource.data.audience in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
      );
      allow create, update, delete: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
